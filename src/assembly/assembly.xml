<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 ">
    <id>make-assembly</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>
<!--        <includes>-->
<!--            <include>${project.build.finalName}-with-dependencies.jar</include>-->
<!--        </includes>-->
    </fileSets>

    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <unpack>true</unpack>
            <unpackOptions>
                <includes>
                    <include>com/shopee/warehouse/**</include>
                    <include>org/apache/hadoop/fs/**</include>
                    <include>org/apache/kyuubi/plugin/**</include>
                    <include>org/apache/kyuubi/util/**</include>
                    <include>com/fasterxml/**</include>
                    <include>com/google/**</include>
                </includes>
            </unpackOptions>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
</assembly>
